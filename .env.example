# ==============================================================================
# Field Notes - Root Environment Configuration Example
# ==============================================================================

# --- Mobile (Flutter) ---
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
API_BASE_URL=http://10.0.2.2:8080

# --- Backend (Spring Boot) ---
# Project Settings -> Database -> Connection parameters
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_secure_database_password

# Project Settings -> General -> Reference ID
SUPABASE_JWK_SET_URI=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json
# Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Private photo storage (backend only; never use this key in Flutter)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=field-note-photos

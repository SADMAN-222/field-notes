# ==============================================================================
# Field Notes Backend - Supabase Configuration
# ==============================================================================

# Supabase PostgreSQL Database Settings
# Find these in your Supabase Dashboard: Project Settings -> Database -> Connection parameters
SUPABASE_DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_secure_database_password

# Alternatively, specify the full JDBC URL (e.g., using Supabase Transaction / Session pooler):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&user=postgres.xxxxxxxxxxxxxxxxxxxx&password=your_secure_database_password

# Supabase Auth / OAuth2 Resource Server Settings
# Find your Project Reference ID in Supabase Dashboard: Project Settings -> General
# Format: https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWK_SET_URI=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/.well-known/jwks.json

# Optional: Supabase Project JWT Secret (Settings -> API -> JWT Secret) for HS256 verification
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Supabase Storage (backend only; never add the service role key to the mobile app)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=field-note-photos

# Application Profile (use 'production' for live Supabase PostgreSQL, 'local' for local development)
SPRING_PROFILES_ACTIVE=production
SPRING_FLYWAY_ENABLED=true

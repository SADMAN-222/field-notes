# Supabase Project URL and Anon Public Key
# Find these in your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Spring Boot REST API Base URL
API_BASE_URL=http://10.0.2.2:8080

# When running or building Flutter with dart-define, pass:
# flutter run --dart-define=SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co --dart-define=SUPABASE_ANON_KEY=eyJhbG...

